{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Loquara",
  "version": "0.4.3",
  "identifier": "io.loquara.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Loquara",
        "width": 1080,
        "height": 720,
        "decorations": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Loquara — dyktowanie",
        "url": "index.html?window=overlay",
        "width": 80,
        "height": 42,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "transparent": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "lib/*.dll": "./"
    }
  }
}
