{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Loquara",
  "version": "0.10.0",
  "identifier": "io.loquara.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/prebuild-engine.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Loquara",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#151515",
        "decorations": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Loquara — dyktowanie",
        "url": "index.html?window=overlay",
        "width": 136,
        "height": 36,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "transparent": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Private, local speech-to-text dictation.",
    "longDescription": "Press a shortcut, speak, and Loquara writes in the active window. Speech is transcribed on your own machine with NVIDIA Parakeet; audio and text never leave it unless you configure a cloud engine.",
    "homepage": "https://loquara.nikodemnowak.pl",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
